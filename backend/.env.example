# Copy to .env for local docker-compose use (never commit the real .env)
DATABASE_URL=jdbc:postgresql://localhost:5432/keystone
DATABASE_USERNAME=keystone
DATABASE_PASSWORD=keystone
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000
ALLOWED_ORIGINS=http://localhost:5173
EMAIL_NOTIFICATIONS_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@keystone.local
